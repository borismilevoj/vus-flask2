ion="BITUMEN"/><word id="58" x="11" y="9-15" solution="SESVETE"/><word id="59" x="4" y="10-15" solution="MIKADO"/><word id="60" x="10" y="10-15" solution="ZOOFAG"/><word id="61" x="13" y="11-15" solution="TNALA"/><word id="62" x="14" y="11-15" solution="EJRIR"/><word id="63" x="15" y="11-15" solution="TEIKA"/><word id="64" x="6" y="12-15" solution="RELI"/><word id="65" x="12" y="12-15" solution="ARAM"/><word id="66" x="1" y="13-15" solution="KGB"/><word id="67" x="2" y="13-15" solution="ARO"/><word id="68" x="3" y="13-15" solution="ROD"/><clues ordering="normal"><title><b>Across</b></title><clue word="1" number="1" citation="perplexity">nekdanje glasilo italijanskih socialistov</clue><clue word="2" number="7" citation="vpis">slovenski politik, novinar in avtor, ki v Italiji deluje kot vidni zagovornik pravic slovenske manjšine (1945-)</clue><clue word="3" number="13" citation="vpis">legendarni francoski tekač na dolge proge alžirskega rodu in eden najuspešnejših športnikov v zgodovini Francije - Alain (1921†2013)</clue><clue word="4" number="14" citation="vpis">dinamična prestolnica Kenije, znana po svoji edinstveni mešanici urbanega življenja in divje narave</clue><clue word="5" number="15" citation="perplexity">nepriznana država na teritoriju dela Sahare in Sahela v Afriki</clue><clue word="6" number="16" citation="perplexity">slovenski umetnostni zgodovinar in konservator - Marijan (1921†2005)</clue><clue word="7" number="17" citation="vpis">postopek zatiranja in zmanjševanja populacije škodljivih glodavcev, kot so podgane, miši in kune</clue><clue word="8" number="19" citation="perplexity">majhno slikovito naselje na Hrvaškem, ki upravno spada pod mesto Opatija v Primorsko-goranski županiji</clue><clue word="9" number="20" citation="vpis">nekdanji maroški poklicni teniški igralec, ki so ga zaradi njegove izjemne tehnike in kreativnosti na igrišču klicali "Maroški čarovnik" - Hicham (1973-)</clue><clue word="10" number="21" citation="perplexity">odrsko glasbeno scensko delo, pri katerem nastopajoči pojejo, igrajo ter plešejo, spremlja pa jih orkester</clue><clue word="11" number="25" citation="vpis">lepo, izbrano, a pogosto vsebinsko prazno govorjenje ali retorično okraševanje misli (star.)</clue><clue word="12" number="27" citation="vpis">srbsko-nemška igralka - Anica (1963-), (Belo se pere na devetdeset)</clue><clue word="13" number="30" citation="vpis">peto največje mesto v Egiptu in glavno mesto province Gharbia. Nahaja se v osrčju delte Nila, približno 90 km severno od Kaira</clue><clue word="14" number="31" citation="vpis">(v Bibliji) Moabitinja (tujka), ki se je omožila v izraelsko družino. Ko so ji umrli mož, tast in svak, bi se lahko vrnila k svojemu ljudstvu, a je ostala zvesta svoji tašči Noemi</clue><clue word="15" number="32" citation="perplexity">luknjač (star.)</clue><clue word="16" number="33" citation="perplexity">čudovita, lahko dostopna hribovska dolina v Julijskih Alpah z istoimenskim planinskim domom, ki je izjemno priljubljen pohodniški in izletniški cilj, z izhodiščno točko v Planici</clue><clue word="17" number="34" citation="perplexity">pakistanski igralec - Sultan Muhammad (1938†1996), (Kaley Chore)</clue><clue word="18" number="35" citation="perplexity">nekdanja francoska teroristična organizacija v Alžiru</clue><clue word="19" number="36" citation="perplexity">velika, močna vrsta divjega goveda, ki živi predvsem v Aziji in Afriki (zool.)</clue><clue word="20" number="37" citation="vpis">trikotni polotok v Egiptu, ki povezuje Afriko in Azijo</clue><clue word="21" number="38" citation="vpis">stanje neizobraženosti, nekulturnosti ali pomanjkanja civilizacijskih norm v vedenju in razmišljanju (slabš.)</clue><clue word="22" number="41" citation="vpis">pripadnik muslimanske vere, ki dosledno sledijo praksi in naukom preroka Mohameda ter skupnosti njegovih prvih privržencev</clue><clue word="23" number="42" citation="vpis">najbolj severni grški otok v Egejskem morju, ki mu zaradi bujnega rastja pravijo tudi "zeleni diamant Grčije"</clue><clue word="24" number="43" citation="perplexity">starogrški podložnik, svobodnjak ali najemnik brez lastnega zemljišča</clue><clue word="25" number="46" citation="vpis">največji slovenski pustni karneval in eden najpomembnejših etnografskih festivalov v Evropi, ki poteka na Ptuju</clue><clue word="26" number="49">vrsta drobne slaščice, narejene iz praženega sladkorja, glukoze in eteričnih olj</clue><clue word="27" number="52" citation="vpis">srbska igralka - Rahela (1911†1994), (Grlom u jagode)</clue><clue word="28" number="53" citation="vpis">surova kovina, ki nastane kot prvi produkt pri pridobivanju železa iz železove rude v plavžu (metal.)</clue><clue word="29" number="54" citation="perplexity">turški šahovski velemojster - Suat (1964-)</clue><clue word="30" number="55" citation="vpis">kategorija modernih serifnih pisav (t.i. Didone slog) in velja za simbol elegance, prestiža in visoke mode</clue><clue word="31" number="56" citation="vpis">osrednji del Talmuda, ki vsebuje podrobne razlage, razprave in komentarje na starejšo judovsko postavo, imenovano Mišna</clue></clues><clues ordering="normal"><title><b>Down</b></title><clue word="32" number="1" citation="perplexity">nigerijski pisatelj - Elechi (1934†2016)</clue><clue word="33" number="2" citation="perplexity">hrvaški TV režiser - Darko (1939†2023)</clue><clue word="34" number="3" citation="vpis">glavno mesto province Maysan na jugovzhodu Iraka, pomembno trgovsko središče ob Tigrisu</clue><clue word="35" number="4" citation="vpis">nenaden, močan izbruh svetlosti zvezde bele pritlikavke (astr.)</clue><clue word="36" number="5" citation="vpis">novozelandski prakuščar s temenskim očesom, zadnja preživela vez z dinozavri (zool.)</clue><clue word="37" number="6" citation="vpis">ime prve in doslej edine predsednica vlade Indije Gandhi  (1917†1984)</clue><clue word="38" number="7" citation="vpis">eden največjih perzijskih pesnikov in pisateljev srednjeveškega obdobja - Muslih al-D